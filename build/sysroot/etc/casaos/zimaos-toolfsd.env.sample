# Optional systemd overrides: copy to /etc/casaos/zimaos-toolfsd.env before editing.
# The package ships only this sample; upgrades preserve the active env file.
TOOLFSD_ROOT=/run/toolfs/mounts
TOOLFSD_SOCKET=/run/toolfs/toolfsd.sock
TOOLFSD_RUNTIME_PATH=/var/run/casaos
TOOLFSD_PERMISSION_CACHE=/var/lib/casaos/toolfs/permission-cache.json

# Legacy account bindings are optional. Agent Management supplies the verified
# ZimaOS identity on each mount request, so no bindings file is needed for it.
TOOLFSD_BINDINGS=

# Unix execution UID/GID, separate from the ZimaOS account ID. Requires a root-owned 0700 mount root.
TOOLFSD_CONTAINER_UID=65534
